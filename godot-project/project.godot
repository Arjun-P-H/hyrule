; Engine configuration file.
; W(x,y) Continuous World Engine — Godot 4
;
; RENDERER (NON-NEGOTIABLE, spec §33): Forward+ is required for SDFGI.
;
; ANTI-ALIASING (Apple Silicon / Metal TBDR, spec §26/§33):
;   msaa_3d = 0            — MSAA multiplies tile bandwidth for a surface
;                            whose "geometry" is an analytic DEPTH write;
;                            the Nyquist-weighted field is the anti-aliaser.
;   screen_space_aa = 1    — FXAA cleans up the raymarch silhouette instead.

config_version=5

[application]

config/name="W(x,y) Continuous World Engine"
config/description="TotK-style exploration terrain as a pure mathematical 2D field — no meshes, raymarched per pixel, CPU twin for physics."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
