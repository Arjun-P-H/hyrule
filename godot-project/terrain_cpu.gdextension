[configuration]

# W(x,y) CPU physics twin — Godot 4 GDExtension.
# Build with gdextension/SConstruct (see README.md). The extension is
# OPTIONAL at runtime: scripts/terrain_math_fallback.gd provides the same
# Dictionary API in pure GDScript (doubles) when this binary is absent,
# so the project always runs — the C++ twin is the shipping path.

entry_symbol = "terrain_cpu_library_init"
compatibility_minimum = "4.3"

[libraries]

macos.debug = "res://gdextension/bin/libterrain_cpu.macos.template_debug.framework"
macos.release = "res://gdextension/bin/libterrain_cpu.macos.template_release.framework"
