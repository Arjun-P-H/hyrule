#!/usr/bin/env python
# ============================================================================
#  W(x,y) CPU twin — GDExtension build (Godot 4, Apple Silicon / arm64)
# ----------------------------------------------------------------------------
#  Prerequisites (one time):
#      git clone -b 4.3 https://github.com/godotengine/godot-cpp godot-cpp
#      (any 4.x branch >= 4.3 works; place it inside this folder)
#
#  Build:
#      scons platform=macos arch=arm64 target=template_debug
#      scons platform=macos arch=arm64 target=template_release
#
#  Output: bin/libterrain_cpu.macos.<target>.framework — wired up by
#  ../terrain_cpu.gdextension at the project root.
#
#  PARITY FLAG (spec §27): -ffp-contract=off keeps the CPU from contracting
#  a·b+c into FMA. The Metal toolchain contracts differently, and an FMA in
#  only one of the twins would break the ≤ 1 mm parity budget that
#  GROUND_BIAS = 0.08 is sized to absorb. Do not remove this flag.
# ============================================================================
import os

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
env.Append(CCFLAGS=["-ffp-contract=off"])
env.Append(CCFLAGS=["-O3"])
env.Append(CXXFLAGS=["-std=c++17"])
# Warnings are parity-relevant (float truncation, shadowing):
env.Append(CCFLAGS=["-Wall", "-Wextra", "-Wno-unused-parameter"])

if env["platform"] == "macos":
    # Apple Silicon target; Godot's Metal backend + Forward+ renderer.
    env["arch"] = env.get("arch", "arm64")

sources = Glob("src/*.cpp")

if env["platform"] != "macos":
    library = env.SharedLibrary(
        "bin/libterrain_cpu.{}.{}.{}".format(env["platform"], env["target"], env["SHLIBSUFFIX"]),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "bin/libterrain_cpu.{}.{}.framework".format(env["platform"], env["target"]),
        source=sources,
    )

Default(library)
